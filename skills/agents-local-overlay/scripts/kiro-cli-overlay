#!/bin/sh
set -u

kiro_bin="$(command -v kiro-cli 2>/dev/null)" || {
  printf '%s\n' 'kiro-cli-overlay: kiro-cli was not found' >&2
  exit 127
}

top_output="$(
  git rev-parse --path-format=absolute --show-toplevel 2>/dev/null || exit 1
  printf .
)" || {
  printf '%s\n' 'kiro-cli-overlay: run this launcher inside a Git worktree' >&2
  exit 1
}
top_output=${top_output%.}
newline='
'
case "$top_output" in
  *"$newline") top=${top_output%"$newline"} ;;
  *)
    printf '%s\n' 'kiro-cli-overlay: could not resolve the Git worktree' >&2
    exit 1
    ;;
esac

script_dir="$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)" || exit 1
helper="$script_dir/agents-overlay-context"
[ -f "$helper" ] || {
  printf '%s\n' "kiro-cli-overlay: missing helper: $helper" >&2
  exit 1
}

kiro_dir="$top/.kiro"
steering_dir="$kiro_dir/steering"
target="$steering_dir/agents-local-overlay.md"
target_rel=.kiro/steering/agents-local-overlay.md
target_pathspec=':(icase,literal).kiro/steering/agents-local-overlay.md'
owner='<!-- generated by agents-local-overlay; do not edit -->'

if [ -L "$kiro_dir" ] || [ -L "$steering_dir" ] || [ -L "$target" ]; then
  printf '%s\n' 'kiro-cli-overlay: .kiro overlay path must not contain symlinks' >&2
  exit 1
fi
if [ -e "$target" ] && [ ! -f "$target" ]; then
  printf '%s\n' "kiro-cli-overlay: reserved path is not a regular file: $target" >&2
  exit 1
fi
if [ -f "$target" ] && [ "$(sed -n '1p' "$target")" != "$owner" ]; then
  printf '%s\n' "kiro-cli-overlay: reserved path already contains another document: $target" >&2
  exit 1
fi
git -C "$top" ls-files --error-unmatch -- "$target_pathspec" >/dev/null 2>&1
tracked_status=$?
case "$tracked_status" in
  0)
    printf '%s\n' "kiro-cli-overlay: generated steering file is tracked: $target_rel" >&2
    exit 1
    ;;
  1) ;;
  *)
    printf '%s\n' 'kiro-cli-overlay: could not inspect tracked steering files' >&2
    exit 1
    ;;
esac
if ! git -C "$top" check-ignore -q -- "$target_rel"; then
  printf '%s\n' "kiro-cli-overlay: add $target_rel to a git ignore file" >&2
  exit 1
fi

if [ ! -e "$kiro_dir" ]; then
  mkdir "$kiro_dir" || exit 1
fi
[ -d "$kiro_dir" ] || {
  printf '%s\n' "kiro-cli-overlay: not a directory: $kiro_dir" >&2
  exit 1
}
if [ ! -e "$steering_dir" ]; then
  mkdir "$steering_dir" || exit 1
fi
[ -d "$steering_dir" ] || {
  printf '%s\n' "kiro-cli-overlay: not a directory: $steering_dir" >&2
  exit 1
}

tmp="$(mktemp "$steering_dir/.agents-local-overlay.XXXXXX")" || exit 1
trap 'unlink "$tmp" 2>/dev/null || :' EXIT HUP INT TERM
printf '%s\n\n' "$owner" > "$tmp" || exit 1
sh "$helper" raw SessionStart cwd:AGENTS.md - "$top" kiro-launcher >> "$tmp" || exit 1
chmod 600 "$tmp" || exit 1
mv -f "$tmp" "$target" || exit 1
trap - EXIT HUP INT TERM

cd -- "$top" || exit 1
exec "$kiro_bin" --v3 "$@"
