#!/bin/sh
set -u

script="$0"
if command -v realpath >/dev/null 2>&1; then
  script="$(realpath "$script")" || {
    printf '%s\n' "kiro-cli-overlay: could not resolve script path: $0" >&2
    exit 1
  }
else
  depth=0
  while [ -L "$script" ]; do
    depth=$((depth + 1))
    [ "$depth" -le 40 ] || {
      printf '%s\n' 'kiro-cli-overlay: too many symlink levels' >&2
      exit 1
    }
    script_dir="$(CDPATH='' cd -- "$(dirname -- "$script")" && pwd)" || exit 1
    target="$(readlink "$script")" || exit 1
    case "$target" in
      /*) script="$target" ;;
      *) script="$script_dir/$target" ;;
    esac
  done
fi
script_dir="$(CDPATH='' cd -- "$(dirname -- "$script")" && pwd)" || exit 1
launcher="$script_dir/kiro_cli_overlay.py"

[ -f "$launcher" ] || {
  printf '%s\n' "kiro-cli-overlay: missing launcher: $launcher" >&2
  exit 1
}
command -v python3 >/dev/null 2>&1 || {
  printf '%s\n' 'kiro-cli-overlay: python3 is required' >&2
  exit 127
}

exec python3 "$launcher" "$@"
